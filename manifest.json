{
  "manifest_version": 3,
  "name": "GIPIX Scraper",
  "version": "1.3.3",
  "description": "Выделите список на любом сайте — расширение распознает товары, видео, статьи, изображения и другой контент, соберёт данные со всех страниц и выгрузит их в таблицу или JSON.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "sidePanel", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "GIPIX Scraper",
    "default_popup": "sidepanel.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
